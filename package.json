{
  "name": "@raydium-io/raydium-sdk-v2",
  "version": "0.0.0",
  "packageManager": "bun@1.3.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "An SDK for building applications on top of Raydium.",
  "license": "GPL-3.0",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "files": [
    "./lib",
    "./src"
  ],
  "repository": "https://github.com/raydium-io/raydium-sdk-V2",
  "publicConfig": {
    "registry": "https://registry.yarnpkg.com",
    "access": "public"
  },
  "keywords": [
    "raydium",
    "solana"
  ],
  "lint-staged": {
    "{src,test,misc}/**/*.ts": [
      "yarn lint"
    ]
  },
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "bun run build",
    "build": "rm -rf lib && tsup src --format cjs,esm --dts --sourcemap --no-splitting --minify -d lib --silent && chmod +x ./build.sh && ./build.sh"
  },
  "peerDependencies": {
    "bn.js": "^5.2.2",
    "decimal.js": "^10.6.0",
    "@solana/buffer-layout": "^4.0.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4" 
  },
  "dependencies": {
    "big.js": "^6.2.2",
    "bs58": "^6.0.0",
    "dayjs": "^1.11.19",
    "decimal.js-light": "^2.5.1",
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2",
    "lodash.set": "^4.3.2",
    "toformat": "^2.0.0",
    "xior": "^0.7.8"
  },
  "devDependencies": {
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.set": "^4.3.9",
    "@tsconfig/node14": "^1.0.3",
    "@types/big.js": "^6.2.2",
    "@types/bn.js": "^5.2.0",
    "tsup": "^5.12.9",
    "typescript": "^4.9.5"
  }
}
